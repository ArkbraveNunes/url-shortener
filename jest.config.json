{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "clearMocks": true,
  "projects": [
    {
      "displayName": "occupa-api",
      "clearMocks": true,
      "rootDir": "./",
      "transform": {
        "^.+\\.(t|j)sx?$": "@swc/jest"
      },
      "moduleNameMapper": {}
    }
  ],
  "testEnvironment": "node",
  "reporters": [
    "default",
    [
      "jest-html-reporter",
      {
        "outputPath": "./reports/test-report.html",
        "pageTitle": "Tests Report",
        "includeFailureMsg": true,
        "openReport": true,
        "expand": true
      }
    ]
  ]
}
